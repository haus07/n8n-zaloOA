{
  "name": "n8n-nodes-zalo-oa",
  "version": "2.0.0",
  "description": "n8n community node tích hợp Zalo Official Account (Zalo OA) – gửi tin tư vấn CS Message (chatbot AI), gửi ZBS Template Message qua SĐT, quản lý người dùng/hội thoại và tự động làm mới Access Token.",
  "license": "MIT",
  "homepage": "https://github.com/haus07/n8n-zaloOA#readme",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "zalo",
    "zalo-oa",
    "zalo official account",
    "zalo zbs",
    "zalo template message",
    "vietnam",
    "messaging",
    "automation"
  ],
  "author": {
    "name": "haus07",
    "url": "https://github.com/haus07"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haus07/n8n-zaloOA.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ZaloOaApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ZaloOa/ZaloOa.node.js",
      "dist/nodes/ZaloOaTrigger/ZaloOaTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
